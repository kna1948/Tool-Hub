local function StopTween()
    local wasRunning = false
    if tweenLoopConnection then
        tweenLoopConnection:Disconnect()
        tweenLoopConnection = nil
        wasRunning = true
    end
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
        wasRunning = true
    end
    if wasRunning then
        RayLib:Notify({Title = "🛑 Tween", Content = "Đã dừng quá trình Tween!", Duration = 1.5})
    end
    return wasRunning
end

local function StartTweenTo(targetCFrameFunc, targetName)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        RayLib:Notify({Title = "Tween Lỗi", Content = "Không tìm thấy nhân vật của bạn!", Duration = 1.5})
        return
    end

    if currentTween or tweenLoopConnection then
        StopTween()
        return
    end

    local initialCF = targetCFrameFunc()
    if not initialCF then
        RayLib:Notify({Title = "Tween Lỗi", Content = "Không tìm thấy vị trí mục tiêu!", Duration = 1.5})
        return
    end

    if Config.TweenLoopEnabled then
        RayLib:Notify({Title = "✈️ Tween Loop", Content = "Bắt đầu bám đuổi liên tục: " .. tostring(targetName), Duration = 2})
        tweenLoopConnection = RunService.RenderStepped:Connect(function()
            local targetCF = targetCFrameFunc()
            if not targetCF or not hrp or not hrp.Parent then
                StopTween()
                return
            end
            local dist = (hrp.Position - targetCF.Position).Magnitude
            if dist > 3 then
                local speed = Config.TweenSpeed
                local dir = (targetCF.Position - hrp.Position).Unit
                hrp.CFrame = hrp.CFrame + dir * math.min(speed * RunService.RenderStepped:Wait(), dist)
            end
        end)
    else
        local distance = (hrp.Position - initialCF.Position).Magnitude
        local speed = Config.TweenSpeed
        local timeVal = math.max(distance / speed, 0.1)

        local tweenInfo = TweenInfo.new(timeVal, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = initialCF + Vector3.new(0, 3, 0)})
        
        currentTween:Play()
        RayLib:Notify({Title = "✈️ Tweening", Content = "Đang bay tới: " .. tostring(targetName) .. " (" .. math.floor(distance) .. "m)", Duration = 2})

        currentTween.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then
                RayLib:Notify({Title = "✅ Hoàn Thành", Content = "Đã đến nơi!", Duration = 1.5})
            end
            currentTween = nil
        end)
    end
end

