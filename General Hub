local function checkMatch(input, targetBind)
    if not targetBind then return false end
    if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode == targetBind then
        return true
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard and input.UserInputType == targetBind then
        return true
    end
    return false
end

keyInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not Config.ScriptRunning then return end

    if Config.AntiAfkEnabled then
        antiAfkTimer = 0
    end

    if checkMatch(input, Config.FlyKeyBind) then
        ToggleHubFly()
    end
end)

task.spawn(function()
    while task.wait(0.05) do 
        if not Config.ScriptRunning then break end
        updateNoDrop()
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if not Config.ScriptRunning then break end

        if Config.AntiAfkEnabled then
            antiAfkTimer = antiAfkTimer + 1
            if antiAfkTimer >= AFK_TIME_LIMIT then
                antiAfkTimer = 0
                pcall(function()
                    game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0))
                    game:GetService("VirtualUser"):Button1Up(Vector2.new(0,0))
                end)
            end
        end

        local character = LocalPlayer.Character
        local myHrp = character and character:FindFirstChild("HumanoidRootPart")

        if Config.CamUnlockEnabled then
            pcall(function()
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
                LocalPlayer.DevComputerCameraMode = Enum.DevComputerCameraMode.Classic
                LocalPlayer.DevTouchCameraMode = Enum.DevTouchCameraMode.Classic
                if LocalPlayer.CameraMinZoomDistance > 1 then
                    LocalPlayer.CameraMinZoomDistance = 0.5
                end
            end)
        end

        if Config.ExtraLookEnabled then
            pcall(function()
                LocalPlayer.CameraMaxZoomDistance = originalMaxZoom + Config.ExtraLookLength
            end)
        end

        if Config.HitboxEnabled then
            pcall(function() UpdateHitboxes() end)
        end

        if Config.HurtboxEnabled then
            pcall(function() UpdateHurtboxes() end)
        end

        if Config.PlayersEnabled and myHrp then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    pcall(function()
                        if p.Character and p.Character.Parent then
                            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                                if dist <= Config.EspRange then
                                    ApplyHighlight(p.Character, Color3.fromRGB(0, 255, 0))
                                    CreateEspTag(p.Character, Color3.fromRGB(0, 255, 0), "")
                                    local tagData = Config.ActiveTags[p.Character]
                                    if tagData and tagData.Label then
                                        tagData.Label.Text = p.Name .. " - " .. dist .. "m"
                                    end
                                else
                                    if Config.ActiveHighlights[p.Character] then
                                        Config.ActiveHighlights[p.Character]:Destroy()
                                        Config.ActiveHighlights[p.Character] = nil
                                    end
                                    if Config.ActiveTags[p.Character] then
                                        Config.ActiveTags[p.Character].Billboard:Destroy()
                                        Config.ActiveTags[p.Character] = nil
                                    end
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
end)
