local function UpdateHurtboxes()
    if not Config.HurtboxEnabled then
        ClearEspType(Config.ActiveHurtboxes)
        return
    end

    local char = LocalPlayer.Character
    if not char then
        ClearEspType(Config.ActiveHurtboxes)
        return
    end

    local currentHurtboxTargets = {}
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Tool") then
            currentHurtboxTargets[child] = true
        end
    end

    for obj, _ in pairs(currentHurtboxTargets) do
        if not Config.ActiveHurtboxes[obj] then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "HurtboxAdornment"
                box.Adornee = handle
                box.AlwaysOnTop = true
                box.ZIndex = 6
                box.Size = handle.Size + Vector3.new(0.3, 0.3, 0.3)
                box.Color3 = Color3.fromRGB(255, 0, 0)
                box.Transparency = 0.4
                box.Parent = obj
                Config.ActiveHurtboxes[obj] = box
            end
        else
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            local box = Config.ActiveHurtboxes[obj]
            if handle and box then
                box.Size = handle.Size + Vector3.new(0.3, 0.3, 0.3)
            end
        end
    end

    for obj, box in pairs(Config.ActiveHurtboxes) do
        if not obj or not obj.Parent or not currentHurtboxTargets[obj] then
            pcall(function() box:Destroy() end)
            Config.ActiveHurtboxes[obj] = nil
        end
    end
end

local function RefreshEspScans()
    if not Config.ScriptRunning then return end
    
    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    if Config.NpcEnabled then
        pcall(function()
            local validEntities = {}

            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v.Parent then
                    local isPlr = false
                    pcall(function() if Players:GetPlayerFromCharacter(v) then isPlr = true end end)
                    
                    if not isPlr then
                        local hrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                        if hrp then
                            local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                            if dist <= Config.EspRange then
                                if IsNpc(v) or IsEntity(v) then
                                    table.insert(validEntities, { Model = v, Distance = dist })
                                end
                            end
                        end
                    end
                end
            end

            table.sort(validEntities, function(a, b) return a.Distance < b.Distance end)

            local currentTopMap = {}
            for i = 1, math.min(#validEntities, 31) do
                currentTopMap[validEntities[i].Model] = true
            end

            for model, hl in pairs(Config.ActiveHighlights) do
                local isPlr = false
                pcall(function() if Players:GetPlayerFromCharacter(model) then isPlr = true end end)
                if not isPlr and not model:IsA("Tool") then
                    if not currentTopMap[model] or not model:IsDescendantOf(workspace) then
                        pcall(function() hl:Destroy() end)
                        Config.ActiveHighlights[model] = nil
                        if Config.ActiveTags[model] then
                            pcall(function() Config.ActiveTags[model].Billboard:Destroy() end)
                            Config.ActiveTags[model] = nil
                        end
                    end
                end
            end

            for i = 1, math.min(#validEntities, 31) do
                local item = validEntities[i]
                local v = item.Model
                local dist = item.Distance
                local color = Color3.fromRGB(0, 150, 255)
                local prefix = "[NPC/Mob]"

                ApplyHighlight(v, color)
                CreateEspTag(v, color, prefix)
                local tagData = Config.ActiveTags[v]
                if tagData and tagData.Label then
                    tagData.Label.Text = prefix .. " " .. v.Name .. " - " .. dist .. "m"
                end
            end
        end)
    end

    if Config.ItemsEnabled or Config.EspAllItemsEnabled then
        pcall(function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Tool") and v.Parent ~= LocalPlayer.Backpack and v.Parent ~= LocalPlayer.Character then
                    local isSelected = (Config.SelectedEspItem ~= "" and v.Name == Config.SelectedEspItem)
                    
                    if Config.EspAllItemsEnabled or (Config.ItemsEnabled and isSelected) then
                        local handle = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
                        if handle then
                            local dist = math.floor((myHrp.Position - handle.Position).Magnitude)
                            if dist <= Config.EspRange then
                                ApplyHighlight(v, Color3.fromRGB(255, 255, 0))
                                CreateEspTag(v, Color3.fromRGB(255, 255, 0), "[Item]")
                                local tagData = Config.ActiveTags[v]
                                if tagData and tagData.Label then
                                    tagData.Label.Text = "[Item] " .. v.Name .. " - " .. dist .. "m"
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end

local function startFlying1()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    pcall(function()
        local bodyGyro = Instance.new("BodyGyro", hrp)
        local bodyVelocity = Instance.new("BodyVelocity", hrp)
        bodyGyro.P = 9e4
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = hrp.CFrame
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)

        flyConnection = RunService.RenderStepped:Connect(function()
            if not Config.FlyEnabled or not Config.ScriptRunning then return end
            local moveVec = Vector3.new(0, 0, 0)
            local camCF = camera.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + camCF.UpVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec = moveVec - camCF.UpVector end
            
            local actualFlySpeed = 16 * (Config.FlySpeedValue * 3)
            bodyVelocity.Velocity = moveVec.Magnitude > 0 and moveVec.Unit * actualFlySpeed or Vector3.new(0, 0, 0)
            bodyGyro.CFrame = camCF
        end)
    end)
end

local function startFlying2()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    pcall(function()
        local bodyGyro = Instance.new("BodyGyro", hrp)
