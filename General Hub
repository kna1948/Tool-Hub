local function updateNoDrop()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        if noDropPart then noDropPart:Destroy() noDropPart = nil end
        return
    end

    local hrp = character.HumanoidRootPart

    -- Nếu nodrop bật và flyoff đang tắt thì duy trì part dưới chân
    if Config.nodrop and not Config.flyoff then
        if not noDropPart or not noDropPart.Parent then
            noDropPart = Instance.new("Part")
            noDropPart.Name = "NoDropPlatform"
            noDropPart.Size = Vector3.new(4, 1, 4)
            noDropPart.Anchored = true
            noDropPart.CanCollide = true
            noDropPart.Transparency = 0.5 
            noDropPart.BrickColor = BrickColor.new("Bright blue")
            noDropPart.Parent = workspace
        end
        
        -- Yêu cầu 1: Nhấn shift thì tp block xuống thêm 5 stud ở no drop
        local dropOffset = 3.5
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
            dropOffset = 8.5 -- 3.5 + 5 studs sâu xuống dưới
        end
        
        noDropPart.Position = hrp.Position - Vector3.new(0, dropOffset, 0)
    else
        if noDropPart then
            noDropPart:Destroy()
            noDropPart = nil
        end
    end
end

