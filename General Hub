            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec = moveVec - Vector3.new(0, 1, 0) end
            
            local actualFlySpeed = 16 * (Config.FlySpeedValue * 3)
            bodyVelocity.Velocity = moveVec.Magnitude > 0 and moveVec.Unit * actualFlySpeed or Vector3.new(0, 0, 0)
            bodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + flatLook)
        end)
    end)
end

local function startFlying3()
    -- Fly 3 dạng kết hợp Heartbeat chạy trực tiếp
    flyConnection = RunService.Heartbeat:Connect(function()
        if not Config.FlyEnabled or not Config.ScriptRunning then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local myHrp = character:FindFirstChild("HumanoidRootPart")
        
        if myHrp and humanoid then
            pcall(function()
                local cam = workspace.CurrentCamera
                local moveDir = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
                
                myHrp.Velocity = moveDir * (16 * (Config.FlySpeedValue * 3))
                humanoid.PlatformStand = true
            end)
        end
    end)
end

local function startFlying4()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    pcall(function()
        local bodyGyro = Instance.new("BodyGyro", hrp)
        local bodyVelocity = Instance.new("BodyVelocity", hrp)
        bodyGyro.P = 100000
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = hrp.CFrame
        
        bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)

        hum.PlatformStand = true

        flyConnection = RunService.RenderStepped:Connect(function()
            if not Config.FlyEnabled or not Config.ScriptRunning then
                hum.PlatformStand = false
                return
            end
            
            hum.PlatformStand = true
            local moveVec = Vector3.new(0, 0, 0)
            local camCF = camera.CFrame
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec = moveVec - Vector3.new(0, 1, 0) end
            
            local actualFlySpeed = 16 * (Config.FlySpeedValue * 3.5)
            if moveVec.Magnitude > 0 then
                bodyVelocity.Velocity = moveVec.Unit * actualFlySpeed
            else
                bodyVelocity.Velocity = Vector3.new(0, 0.1, 0)
            end
            bodyGyro.CFrame = camCF
        end)
    end)
end

local function stopFlyingPhysics()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp then
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("BodyGyro") or v:IsA("BodyVelocity") then v:Destroy() end
            end
        end
        if hum then hum.PlatformStand = false end
    end)
end

local function ToggleHubFly()
    if not Config.ScriptRunning then return end
    Config.FlyEnabled = not Config.FlyEnabled
    
    Config.flyoff = Config.FlyEnabled

    if Config.FlyEnabled then
        RayLib:Notify({Title = "Fly", Content = "Đã Bật Bay (" .. Config.FlyMode .. ")", Duration = 1.5})
        if Config.FlyMode == "Fly 1" then startFlying1()
        elseif Config.FlyMode == "Fly 2" then startFlying2()
        elseif Config.FlyMode == "Fly 3" then startFlying3()
        elseif Config.FlyMode == "Fly 4" then startFlying4() end
    else
        RayLib:Notify({Title = "Fly", Content = "Đã Tắt Bay", Duration = 1.5})
        stopFlyingPhysics()
    end
end

