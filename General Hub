local closehub = function()
    -- Tắt toàn bộ Config
    Config.ScriptRunning = false
    Config.PlayersEnabled = false
    Config.NpcEnabled = false
    Config.ItemsEnabled = false
    Config.EspAllItemsEnabled = false
    Config.HitboxEnabled = false
    Config.HurtboxEnabled = false
    Config.NpcExpandHitboxEnabled = false
    Config.ExtraLookEnabled = false
    Config.NoclipEnabled = false
    Config.FlyEnabled = false
    Config.WalkSpeedEnabled = false
    Config.JumpPowerEnabled = false
    Config.FullbrightEnabled = false
    Config.CamUnlockEnabled = false
    Config.HeldToolCanCollide = false
    Config.FakePlayerEnabled = false
    Config.AntiAfkEnabled = false
    Config.nodrop = false
    Config.flyoff = false
    Config.TweenLoopEnabled = false
    Config.WaypointTweenLoopEnabled = false
    
    -- Dọn dẹp Fly & ESP
    stopFlyingPhysics()
    if flyConnection then pcall(function() flyConnection:Disconnect() end) flyConnection = nil end
    CleanupAllWorkspaceEsp()
    
    -- Ngắt tất cả các kết nối (Connections) chạy ngầm
    if noclipConnection then pcall(function() noclipConnection:Disconnect() end) noclipConnection = nil end
    if keyInputConnection then pcall(function() keyInputConnection:Disconnect() end) keyInputConnection = nil end
    if fullbrightConnection then pcall(function() fullbrightConnection:Disconnect() end) fullbrightConnection = nil end
    if tweenLoopConnection then pcall(function() tweenLoopConnection:Disconnect() end) tweenLoopConnection = nil end
    if fakePlayerConnection then pcall(function() fakePlayerConnection:Disconnect() end) fakePlayerConnection = nil end

    -- Dọn dẹp Tween, Fake Player và No Drop Part
    if currentTween then pcall(function() currentTween:Cancel() end) currentTween = nil end
    if fakePlayerDummy then pcall(function() fakePlayerDummy:Destroy() end) fakePlayerDummy = nil end
    if noDropPart then pcall(function() noDropPart:Destroy() end) noDropPart = nil end

    -- Reset kích thước Hitbox NPC về ban đầu
    for npcPart, originalSize in pairs(OriginalNpcSizes) do
        if npcPart and npcPart.Parent then
            pcall(function() npcPart.Size = originalSize end)
        end
    end
    OriginalNpcSizes = {}

    -- Khôi phục môi trường Lighting và trạng thái nhân vật
    pcall(function()
        Lighting.Brightness = originalBrightness
        Lighting.ClockTime = originalClockTime
        Lighting.FogEnd = originalFogEnd
        Lighting.GlobalShadows = originalGlobalShadows
        LocalPlayer.CameraMaxZoomDistance = originalMaxZoom

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.WalkSpeed = originalWalkSpeed
            hum.JumpPower = originalJumpPower
            hum.UseJumpPower = true
            hum.PlatformStand = false
        end
        
        for part, originalState in pairs(noclipSavedStates) do
            if part and part.Parent then
                part.CanCollide = originalState
            end
        end
        noclipSavedStates = {}

        if hrp then hrp.Velocity = Vector3.new(0, 0, 0) end
    end)
    
    getgenv().closewithnohub = nil
end

getgenv().closewithnohub = {
    Loaded = true,
    CloseFunction = closehub,
}

