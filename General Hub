end

local function GetItemList()
    local list = {}
    local seen = {}
    local function scanContainer(container)
        if not container then return end
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(list, item.Name)
            end
        end
    end
    scanContainer(LocalPlayer.Backpack)
    scanContainer(LocalPlayer.Character)
    
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and not seen[obj.Name] then
                seen[obj.Name] = true
                table.insert(list, obj.Name)
            end
        end
    end)

    if #list == 0 then table.insert(list, "Không có item nào") end
    return list
end

local function IsEntity(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    local isPlr = false
    pcall(function()
        if Players:GetPlayerFromCharacter(model) then isPlr = true end
    end)
    if isPlr then return false end

    if model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart then
        return true
    end
    return false
end

local function IsNpc(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    local isPlr = false
    pcall(function()
        if Players:GetPlayerFromCharacter(model) then isPlr = true end
    end)
    if isPlr then return false end

    local parentName = model.Parent and string.lower(model.Parent.Name) or ""
    if parentName:match("npc") or parentName:match("quest") or parentName:match("character") or parentName:match("giver") then
        return true
    end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Anchored then return true end

    return false
end

local function GetNpcList()
    local list = {}
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and (IsNpc(v) or IsEntity(v)) then
                if not table.find(list, v.Name) then table.insert(list, v.Name) end
            end
        end
    end)
    if #list == 0 then table.insert(list, "Không có NPC/Mob") end
    return list
end

