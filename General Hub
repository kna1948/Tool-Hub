        ClearEspType(Config.ActiveHitboxes)
        return
    end

    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    if not myHrp then
        ClearEspType(Config.ActiveHitboxes)
        return
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local char = p.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                if p ~= LocalPlayer and dist <= Config.EspRange then
                    if not Config.ActiveHitboxes[char] then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "HitboxAdornment"
                        box.Adornee = hrp
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Size = hrp.Size + Vector3.new(0.5, 0.5, 0.5)
                        box.Color3 = Color3.fromRGB(0, 255, 0)
                        box.Transparency = 0.5
                        box.Parent = char
                        Config.ActiveHitboxes[char] = box
                    else
                        local box = Config.ActiveHitboxes[char]
                        if box and box.Parent then
                            box.Size = hrp.Size + Vector3.new(0.5, 0.5, 0.5)
                        end
                    end
                else
                    if Config.ActiveHitboxes[char] then
                        pcall(function() Config.ActiveHitboxes[char]:Destroy() end)
                        Config.ActiveHitboxes[char] = nil
                    end
                end
            end
        end
    end

    for _, v in pairs(CachedHitboxTargets) do
        if v and v.Parent then
            local hrp = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
            if hrp then
                local dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                if dist <= Config.EspRange then
                    if not Config.ActiveHitboxes[v] then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "HitboxAdornment"
                        box.Adornee = hrp
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Size = hrp.Size + Vector3.new(0.2, 0.2, 0.2)
                        box.Color3 = Color3.fromRGB(0, 255, 100)
                        box.Transparency = 0.5
                        box.Parent = v
                        Config.ActiveHitboxes[v] = box
                    else
                        local box = Config.ActiveHitboxes[v]
                        if box and box.Parent then
                            box.Size = hrp.Size + Vector3.new(0.2, 0.2, 0.2)
